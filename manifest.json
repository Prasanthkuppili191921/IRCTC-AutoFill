{
  "manifest_version": 3,
  "name": "IRCTC AutoFill Assistant",
  "version": "1.0.0",
  "description": "Fill passenger details on IRCTC booking forms.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.irctc.co.in/*"
      ],
      "js": [
        "content/content-1.js",
        "content/content-2.js",
        "content/content-3.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "IRCTC AutoFill"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
